# ---------------------------------------------------------------------------
# Private source documents
# ---------------------------------------------------------------------------
# The workshop is demoed against an internal document that must never leave the
# presenter's machine. No PDF is committed anywhere in this repo: attendees
# supply their own, and tests generate a synthetic one at runtime. The rule is
# therefore absolute with no allow-list, so dropping a confidential file into
# any folder here cannot commit it by accident.
*.pdf

# Presenter-local Compose overrides (bind-mounts the internal document)
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Runtime data
# ---------------------------------------------------------------------------
/data/
chroma-data/

# ---------------------------------------------------------------------------
# Secrets and local config
# ---------------------------------------------------------------------------
.env
.env.local

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Model weights (baked into the Docker image at build time, never committed)
# ---------------------------------------------------------------------------
.cache/
hf_home/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.impeccable/

# SDD scratch
.superpowers/

# Internal spec and implementation plan: kept locally, not published. The plan
# contains superseded reference code -- four bugs were found and fixed during
# execution -- so shipping it would hand readers broken versions of logic the
# repo now gets right. app/ is the source of truth.
docs/superpowers/

# Swagger UI assets, vendored into the image at build time rather than
# committed. See the RUN step in app/Dockerfile.
app/static/vendor/

# Knowledge-graph output from the graphify skill (regenerable, 1.5M)
graphify-out/
