# Copy to .env to override any default. Every value here is the shipped
# default; the comment names the deck slide it came from.

CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=workshop

# Level 2, model table, self-host row: 384 dims, CPU, no API key
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMS=384
EMBED_BATCH_SIZE=64

# Level 6, "Sensible defaults for version one"
DEFAULT_CHUNK_SIZE=700
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_STRATEGY=recursive
SEMANTIC_PERCENTILE=95

MAX_UPLOAD_MB=30
DATA_DIR=/data

# Presenter convenience; see docker-compose.override.yml.example
# LOCAL_PDF_PATH=/srv/samples/local.pdf

# --- Answer generation on the /chat page (optional) -------------------------
# Retrieval always works. Generation is opt-in: leave OLLAMA_BASE_URL empty and
# the chat page answers extractively from the retrieved chunks, which is what an
# attendee cloning this repo gets with no setup at all.
#
# To enable it you need two things, and the second one catches people out:
#   1. Uncomment the line below.
#   2. Start Ollama listening beyond localhost -- OLLAMA_HOST=0.0.0.0 ollama
#      serve -- because it binds to 127.0.0.1 by default and refuses traffic
#      from the container even with the host-gateway mapping in place.
#
# Note a 1.5B model can take 10s+ on a cold first call. The page streams tokens
# so it never looks frozen, but budget for it if you are demoing live.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=deepseek-r1:1.5b

# --- Retrieval defaults for /chat -------------------------------------------
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.25
# RETRIEVAL_MMR_LAMBDA=0.5
# RETRIEVAL_POOL_MULTIPLIER=4
